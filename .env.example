# Database (Supabase Postgres / Postgres apa pun)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Auth
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Lindungi endpoint cron Vercel (isi juga di Vercel env)
CRON_SECRET=ganti-dengan-string-acak

# Payment gateways (opsional, isi sesuai kebutuhan)
XENDIT_SECRET_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=

# Notifikasi (opsional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
TELEGRAM_BOT_TOKEN=

# GenieACS NBI (server-side). NBI is normally port 7557, NOT the UI/CWMP port.
GENIEACS_NBI_URL=
# Optional authentication provided by your NBI reverse proxy (choose one):
GENIEACS_NBI_USERNAME=
GENIEACS_NBI_PASSWORD=
GENIEACS_NBI_TOKEN=
